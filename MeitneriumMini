local function getAutoSetBall()
    for _, m in ipairs(CollectionService:GetTagged("Ball")) do
        if m:IsA("Model") then return m end
    end
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Model") and child.Name:match("^CLIENT_BALL_%d+$") then return child end
    end
    return nil
end

local function getBallPart(ball)
    if not ball then return nil end
    if ball:IsA("BasePart") then return ball end
    if ball.PrimaryPart then return ball.PrimaryPart end
    for _, d in ipairs(ball:GetDescendants()) do
        if d:IsA("BasePart") and d.Name ~= "MeitneriumHitbox" then return d end
    end
    return nil
end

local function getBallVelocity(ball, fallbackVel)
    local part = getBallPart(ball)
    if part then
        local ok, v = pcall(function() return part.AssemblyLinearVelocity end)
        if ok and typeof(v) == "Vector3" and v.Magnitude > 0.05 then return v end
        ok, v = pcall(function() return part.Velocity end)
        if ok and typeof(v) == "Vector3" and v.Magnitude > 0.05 then return v end
    end
    return fallbackVel or Vector3.zero
end

local function resolveGameController()
    if AutoSetGameController then return AutoSetGameController end
    local ok, Knit = pcall(require, ReplicatedStorage.Packages.Knit)
    if ok and type(Knit) == "table" then
        local ok2, gc = pcall(function() return Knit.GetController("GameController") end)
        if ok2 and type(gc) == "table" and type(gc.DoMove) == "function" then
            AutoSetGameController = gc
            return gc
        end
    end
    return AutoSetGameController
end

local function fireAutoSetMove()
    local gc = resolveGameController()
    if not gc then return false end
    local ok = pcall(function()
        gc:DoMove({
            ActionName = "Set",
            IsAerial = false,
            InputState = Enum.UserInputState.Begin,
            Metadata = {},
        })
    end)
    if ok then
        autoReceiveLastFire = tick()
        autoReceiveUsedThisTouch = true
    end
    return ok
end

local autoReceiveSep = Instance.new("Frame")
autoReceiveSep.Size = UDim2.new(0.8, 0, 0, 1)
autoReceiveSep.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
autoReceiveSep.BorderSizePixel = 0
autoReceiveSep.LayoutOrder = 50
autoReceiveSep.Parent = frame

makeToggle(frame, "Auto Receive", 51, false, function(v)
    AutoSetEnabled = v
    autoSetLastBallPos = nil
    autoReceiveUsedThisTouch = false
    if v then resolveGameController() end
end)

RunService.Heartbeat:Connect(function(dt)
    if not AutoSetEnabled then
        autoSetLastBallPos = nil
        autoReceiveUsedThisTouch = false
        return
    end
    if not Root or not Root.Parent then
        local char = LocalPlayer.Character
        if char then
            Root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
            Humanoid = char:FindFirstChildOfClass("Humanoid")
        end
    end
    if not Root or not Humanoid then return end

    local state = Humanoid:GetState()
    if state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall
        or state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.FallingDown then
        autoSetLastBallPos = nil
        return
    end

    local ball = getAutoSetBall()
    if not ball then
        autoSetLastBallPos = nil
        autoReceiveUsedThisTouch = false
        return
    end

    local part = getBallPart(ball)
    local ballPos = part and part.Position
    if not ballPos then
        local ok, pivot = pcall(function() return ball:GetPivot() end)
        ballPos = ok and pivot and pivot.Position
    end
    if not ballPos then return end

    local rootPos = Root.Position
    local dist = (ballPos - rootPos).Magnitude

    if autoReceiveUsedThisTouch then
        if dist > RESET_RANGE then autoReceiveUsedThisTouch = false
        else autoSetLastBallPos = ballPos return end
    end
    if dist > DETECT_RANGE then autoSetLastBallPos = ballPos return end

    local fallbackVel = Vector3.zero
    if autoSetLastBallPos and dt > 1e-4 then
        fallbackVel = (ballPos - autoSetLastBallPos) / dt
    end
    autoSetLastBallPos = ballPos
    local vel = getBallVelocity(ball, fallbackVel)

    local g = 17
    pcall(function()
        local Game = dynamicRequire(ReplicatedStorage.Configuration.Game)
        local State = dynamicRequire(ReplicatedStorage.Common.State)
        local gv = State.get(ReplicatedStorage, State.Id.Modifier, "BallGravity", Game.Physics.Gravity)
        if type(gv) == "number" and gv > 0 then g = gv end
    end)

    local floorY = nil
    local okPh, physicsMod = pcall(require, ReplicatedStorage.Common.Physics)
    if okPh and type(physicsMod) == "table" then
        floorY = physicsMod.LastFloorHeight
        if not floorY then
            local okF, h = pcall(physicsMod.calculateFloorHeight, ballPos, true)
            floorY = okF and h or nil
        end
    end

    local eta = math.huge
    if vel.Y < 0.5 and floorY then
        local drop = ballPos.Y - floorY
        if drop > 0 then
            local disc = vel.Y * vel.Y + 2 * g * drop
            if disc >= 0 then
                local flight = (vel.Y + math.sqrt(disc)) / g
                if flight > 0 and flight < 4 then
                    eta = flight
                end
            end
        end
    end

    local toPlayer = rootPos - ballPos
    if toPlayer.Magnitude > 0.05 then
        local closing = vel:Dot(toPlayer.Unit)
        if closing > 1.2 then
            eta = math.min(eta, (ballPos - rootPos).Magnitude / closing)
        end
    end

    local shouldFire = (eta <= CONTACT_WINDOW and eta >= 0) or (ballPos - rootPos).Magnitude <= 6
    if shouldFire and not autoReceiveUsedThisTouch and tick() - autoReceiveLastFire > 0.55 then
        fireAutoSetMove()
    end
end)

