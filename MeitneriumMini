--// == PLAYER LINES ==
local lineDistance = 50
local linesEnabled = false
local lines = {}
local lineColors = {
    Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 255, 0),
    Color3.fromRGB(0, 0, 255), Color3.fromRGB(255, 165, 0),
    Color3.fromRGB(128, 0, 128), Color3.fromRGB(255, 255, 0),
    Color3.fromRGB(139, 0, 0), Color3.fromRGB(0, 100, 0),
}

local function removeLine(player)
    local data = lines[player]
    if not data then return end
    pcall(function() if data.beam then data.beam:Destroy() end end)
    pcall(function() if data.target and data.target.Parent then data.target:Destroy() end end)
    pcall(function() if data.attachment and data.attachment.Parent then data.attachment:Destroy() end end)
    lines[player] = nil
end

local function updateLine(player, index)
    if player == LocalPlayer or not linesEnabled then removeLine(player) return end
    if player.Team == LocalPlayer.Team then removeLine(player) return end
    local character = player.Character
    local head = character and character:FindFirstChild("Head")
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not head or not rootPart then removeLine(player) return end

    if not lines[player] then
        local attachment = Instance.new("Attachment")
        attachment.Parent = head
        local target = Instance.new("Part")
        target.Name = "MeitneriumLineTarget"
        target.Anchored = true
        target.CanCollide = false
        target.CanQuery = false
        target.CanTouch = false
        target.Transparency = 1
        target.Size = Vector3.new(0.1, 0.1, 0.1)
        target.Parent = workspace
        local targetAttachment = Instance.new("Attachment")
        targetAttachment.Parent = target
        local beam = Instance.new("Beam")
        beam.Attachment0 = attachment
        beam.Attachment1 = targetAttachment
        beam.Width0 = 0.25
        beam.Width1 = 0.25
        beam.FaceCamera = true
        beam.LightEmission = 1
        beam.Transparency = NumberSequence.new(0.3)
        beam.Color = ColorSequence.new(lineColors[((index - 1) % #lineColors) + 1])
        beam.Parent = head
        lines[player] = { beam = beam, target = target, attachment = attachment }
    end

    local data = lines[player]
    if data and data.target and data.target.Parent then
        data.target.Position = head.Position + rootPart.CFrame.LookVector * lineDistance
    end
end

RunService.RenderStepped:Connect(function()
    if linesEnabled then
        for index, player in ipairs(Players:GetPlayers()) do
            updateLine(player, index)
        end
    else
        for player in pairs(lines) do removeLine(player) end
    end
end)
Players.PlayerRemoving:Connect(removeLine)

